VITE_API_URL=http://localhost:8000

# Zitadel OIDC (see docker-compose.yml — local instance runs on :8081).
# Client ID of the Web/PKCE application created in the Zitadel console;
# the app must have Auth Token Type = JWT and ${origin}/callback as a
# registered redirect URI.
VITE_ZITADEL_AUTHORITY=http://localhost:8081
VITE_ZITADEL_CLIENT_ID=
